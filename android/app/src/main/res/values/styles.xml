<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Judul halaman -->
    <style name="TextAppearance.PageTitle" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Label / caption -->
    <style name="TextAppearance.Label" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Card konten -->
    <style name="Widget.ProjectorRemote.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <!-- Tombol mic utama -->
    <style name="Widget.ProjectorRemote.MicButton" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">60dp</item>
        <item name="iconTint">@color/white</item>
    </style>
</resources>
